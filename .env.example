# Copy to .env, fill in, then: set -a; . ./.env; set +a

# --- always ---
ABUS_MACHINE=HUB              # this machine's name. Peers need names; they are identities.
ABUS_DIR=~/.abus              # state: ledger shards, cursors, session file
ABUS_TRANSPORT=file           # file | telegram

# --- telegram transport only ---
# api_id / api_hash come from https://my.telegram.org -> API development tools.
# These are a USER account's credentials, not a bot token. Bots cannot see each
# other's messages, so a bot per machine cannot work at all: docs/GOTCHAS.md #1.
ABUS_TG_API_ID=
ABUS_TG_API_HASH=
ABUS_TG_CHAT=                 # group chat id, e.g. -1001234567890
ABUS_TG_SESSION=              # optional; default $ABUS_DIR/abus-<MACHINE>.session
